ragflow:
  host: 0.0.0.0
  http_port: 9380

mysql:
  name: 'rag_flow'
  user: 'root'
  password: 'YOUR_MYSQL_PASSWORD_HERE'  # 请修改
  host: 'localhost'
  port: 5455
  max_connections: 100
  stale_timeout: 30

minio:
  user: 'rag_flow'
  password: 'YOUR_MINIO_PASSWORD_HERE'  # 请修改
  host: 'localhost:9000'

es:
  hosts: 'http://localhost:1200'
  username: 'elastic'
  password: 'YOUR_ES_PASSWORD_HERE'  # 请修改

redis:
  db: 1
  password: 'YOUR_REDIS_PASSWORD_HERE'  # 请修改
  host: 'localhost:6379'

user_default_llm:
  factory: 'OpenAI-API-Compatible'
  api_key: 'YOUR_API_KEY_HERE'  # 请修改为你的 API Key
  chat_model: Qwen/Qwen3-VL-32B-Instruct
  chat_base_url: 'https://api.siliconflow.cn/v1'
  embedding_model: qwen3-vl
  embedding_base_url: 'http://localhost:8000/v1'
  rerank_model: qwen3-vl-rerank
  rerank_base_url: 'http://localhost:8001/v1'
