[Unit]
Description=RAGFlow Plus API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/jianhuasuo/lingji
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/user/jianhuasuo/lingji
ExecStart=/usr/local/bin/ragflow-api-start
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
