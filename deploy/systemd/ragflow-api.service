[Unit]
Description=RAGFlow Plus API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/jianhuasuo/lingji
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/user/jianhuasuo/lingji
EnvironmentFile=-/home/user/jianhuasuo/lingji/conf/ragflow-secret.env
ExecStart=/usr/local/bin/ragflow-api-start
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
