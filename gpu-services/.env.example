# GPU 服务环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ============== Qwen3 VL Service ==============
# Qwen3-VL 模型路径
QWEN_VL_MODEL_PATH=/models/Qwen3-VL-Embedding-2B

# 最大批处理大小（根据显存调整）
QWEN_VL_MAX_BATCH_SIZE=1

# ============== Qwen3 Rerank Service ==============
# Qwen3 Rerank 模型路径
QWEN_RERANK_MODEL_PATH=/models/Qwen3-VL-Reranker-2B

# 最大批处理大小（Rerank 显存占用高，建议设为 1）
QWEN_RERANK_MAX_BATCH_SIZE=1

# ============== MinIO 配置 (共享) ==============
# MinIO 服务地址
MINIO_ENDPOINT=localhost:9000

# MinIO 访问凭证
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow

# 是否使用 HTTPS
MINIO_SECURE=false

# ============== MinerU OCR Service ==============
# PDF 解析模式: ocr, txt, auto
MINERU_PARSE_METHOD=auto

# ============== GPU 配置 ==============
# 指定使用的 GPU（例如: "0,1" 或 "all"）
CUDA_VISIBLE_DEVICES=all
